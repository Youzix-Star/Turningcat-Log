---
const currentPath = Astro.url.pathname;
---

<header>
  <nav>
    <a href="/" class="logo">
      <span class="material-symbols-outlined icon-filled">pets</span>
      <span class="logo-text">Turningcat Log</span>
    </a>
    <div class="nav-links">
      <a href="/" class:list={[{ active: currentPath === '/' }]}>
        <span class="material-symbols-outlined">home</span>
        <span>首页</span>
      </a>
      <a href="https://t.me/Turningcat_bot" target="_blank" class="bot-link">
        <span class="material-symbols-outlined">smart_toy</span>
        <span>Telegram Bot</span>
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-bottom: var(--glass-border);
    box-shadow: var(--shadow);
  }

  nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.875rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .logo:hover {
    color: var(--primary);
  }

  .logo .material-symbols-outlined {
    font-size: 1.5rem;
    color: var(--primary);
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .nav-links a {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.5rem 0.875rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
  }

  .nav-links a .material-symbols-outlined {
    font-size: 1.125rem;
  }

  .bot-link {
    background: var(--primary) !important;
    color: white !important;
    padding: 0.5rem 1rem !important;
    border-radius: 8px !important;
    font-size: 0.875rem !important;
    box-shadow: var(--shadow);
    transition: all 0.2s ease !important;
  }

  .bot-link:hover {
    background: var(--primary-dark) !important;
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .bot-link .material-symbols-outlined {
    font-size: 1rem !important;
  }

  @media (max-width: 640px) {
    nav {
      padding: 0.75rem 1rem;
    }

    .nav-links a span:not(.material-symbols-outlined) {
      display: none;
    }

    .bot-link span:not(.material-symbols-outlined) {
      display: inline !important;
    }

    .bot-link {
      font-size: 0.8rem !important;
      padding: 0.4rem 0.75rem !important;
    }
  }
</style>