---
const currentPath = Astro.url.pathname;
---

<header>
  <nav>
    <a href="/" class="logo">
      <span class="material-symbols-outlined icon-filled">pets</span>
      <span class="logo-text">Turningcat Log</span>
    </a>
    <div class="nav-links">
      <a href="/" class:list={[{ active: currentPath === '/' }]}>
        <span class="material-symbols-outlined">home</span>
        <span>首页</span>
      </a>
      <button class="theme-toggle" id="themeToggle" aria-label="切换深色模式">
        <span class="material-symbols-outlined theme-icon-light">light_mode</span>
        <span class="material-symbols-outlined theme-icon-dark">dark_mode</span>
      </button>
      <a href="https://t.me/Turningcat_bot" target="_blank" class="bot-link" title="Telegram Bot">
        <span class="material-symbols-outlined">smart_toy</span>
        <span>Bot</span>
      </a>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('themeToggle');
    const html = document.documentElement;
    
    const savedTheme = localStorage.getItem('theme') || 'light';
    if (savedTheme === 'dark') {
      html.classList.add('dark');
    }
    
    themeToggle.addEventListener('click', () => {
      html.classList.toggle('dark');
      const isDark = html.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-bottom: var(--glass-border);
    box-shadow: var(--shadow);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.875rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .logo:hover {
    color: var(--primary);
  }

  .logo .material-symbols-outlined {
    font-size: 1.5rem;
    color: var(--primary);
  }

  .nav-links {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  /* 统一按钮基础样式 */
  .nav-links a:not(.logo),
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .nav-links a:not(.logo):hover,
  .theme-toggle:hover {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .nav-links a:not(.logo).active {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .nav-links a:not(.logo) .material-symbols-outlined,
  .theme-toggle .material-symbols-outlined {
    font-size: 1.125rem;
  }

  /* 主题切换按钮特殊处理 */
  .theme-toggle {
    position: relative;
    overflow: hidden;
  }

  .theme-icon-light {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .theme-icon-dark {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition: opacity 0.3s ease, transform 0.3s ease;
    position: absolute;
  }

  :root.dark .theme-icon-light {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  :root.dark .theme-icon-dark {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :root.dark .theme-toggle {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.2);
  }

  :root.dark .theme-toggle:hover {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.15);
    border-color: rgba(251, 191, 36, 0.3);
  }

  @media (max-width: 640px) {
    nav {
      padding: 0.75rem 1rem;
    }

    .nav-links a:not(.logo) span:not(.material-symbols-outlined),
    .bot-link span:not(.material-symbols-outlined) {
      display: none;
    }
  }
</style>