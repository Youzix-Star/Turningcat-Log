---
interface Props {
  title: string;
  date: Date;
  source?: string;
  slug: string;
  translated?: boolean;
  format?: string;
  excerpt?: string;
  channelName?: string;
  channelUsername?: string;
  channelAvatar?: string;
}

const { title, date, source, slug, translated, format, excerpt, channelName, channelUsername, channelAvatar } = Astro.props;

const formatDate = (d: Date) => {
  return d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
};

const getSourceName = () => {
  if (channelName) return channelName;
  if (!source) return '未知频道';
  const match = source.match(/t\.me\/([^/]+)/);
  return match ? `@${match[1]}` : '频道';
};
---

<article class="log-card">
  <div class="card-header">
    <div class="channel-info">
      {channelAvatar ? (
        <img src={channelAvatar} alt={channelName || '频道'} class="channel-avatar" loading="lazy" />
      ) : (
        <div class="channel-avatar-placeholder">
          <span class="material-symbols-outlined">group</span>
        </div>
      )}
      <div class="channel-meta">
        <span class="channel-name">{getSourceName()}</span>
        <div class="date">
          <span class="material-symbols-outlined">calendar_today</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
        </div>
      </div>
    </div>
    <div class="badges">
      {translated && (
        <span class="badge translated" title="已翻译">
          <span class="material-symbols-outlined">translate</span>
        </span>
      )}
      {format && (
        <span class="badge format">
          <span class="material-symbols-outlined">description</span>
          {format.toUpperCase()}
        </span>
      )}
    </div>
  </div>

  <h2>
    <a href={`/log/${slug}`}>{title}</a>
  </h2>

  {excerpt && <p class="excerpt">{excerpt}</p>}

  <div class="card-footer">
    <a href={`/log/${slug}`} class="read-more">
      <span>查看详情</span>
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    {source && channelUsername && (
      <a href={source} target="_blank" rel="noopener noreferrer" class="source-link">
        <span class="material-symbols-outlined">open_in_new</span>
      </a>
    )}
  </div>
</article>

<style>
  .log-card {
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
  }

  .log-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .channel-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .channel-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow);
    border: 2px solid var(--glass-border);
  }

  .channel-avatar-placeholder {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow);
  }

  .channel-avatar-placeholder .material-symbols-outlined {
    font-size: 1.25rem;
    color: white;
  }

  .channel-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .channel-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
  }

  .date {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .date .material-symbols-outlined {
    font-size: 0.875rem;
  }

  .badges {
    display: flex;
    gap: 0.375rem;
  }

  .badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge .material-symbols-outlined {
    font-size: 1rem;
  }

  .badge.translated {
    background: rgba(14, 165, 233, 0.1);
    color: var(--accent);
  }

  .badge.format {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary);
    width: auto;
    padding: 0 0.625rem;
    gap: 0.25rem;
    font-size: 0.7rem;
  }

  h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  h2 a {
    color: var(--text);
    transition: color 0.2s ease;
  }

  h2 a:hover {
    color: var(--primary);
  }

  .excerpt {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.6;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--primary);
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .read-more:hover {
    gap: 0.625rem;
    color: var(--primary-dark);
  }

  .read-more .material-symbols-outlined {
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .read-more:hover .material-symbols-outlined {
    transform: translateX(2px);
  }

  .source-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .source-link:hover {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
  }

  .source-link .material-symbols-outlined {
    font-size: 1rem;
  }
</style>