---
interface Props {
  title: string;
  date: Date;
  source?: string;
  slug: string;
  translated?: boolean;
  format?: string;
  excerpt?: string;
}

const { title, date, source, slug, translated, format, excerpt } = Astro.props;

const formatDate = (d: Date) => {
  return d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
};

const getSourceName = (url?: string) => {
  if (!url) return '未知来源';
  const match = url.match(/t\.me\/([^/]+)/);
  return match ? `@${match[1]}` : '频道';
};
---

<article class="log-card">
  <div class="card-header">
    <div class="date">
      <span class="material-symbols-outlined">calendar_today</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <div class="badges">
      {translated && (
        <span class="badge translated">
          <span class="material-symbols-outlined">translate</span>
          已翻译
        </span>
      )}
      {format && (
        <span class="badge format">
          <span class="material-symbols-outlined">description</span>
          {format.toUpperCase()}
        </span>
      )}
    </div>
  </div>

  <h2>
    <a href={`/log/${slug}`}>{title}</a>
  </h2>

  {source && (
    <a href={source} target="_blank" rel="noopener noreferrer" class="source">
      <span class="material-symbols-outlined">link</span>
      {getSourceName(source)}
    </a>
  )}

  {excerpt && <p class="excerpt">{excerpt}</p>}

  <a href={`/log/${slug}`} class="read-more">
    <span>查看详情</span>
    <span class="material-symbols-outlined">arrow_forward</span>
  </a>
</article>

<style>
  .log-card {
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
  }

  .log-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .date {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .date .material-symbols-outlined {
    font-size: 1rem;
  }

  .badges {
    display: flex;
    gap: 0.5rem;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge .material-symbols-outlined {
    font-size: 0.875rem;
  }

  .badge.translated {
    background: rgba(14, 165, 233, 0.1);
    color: var(--accent);
  }

  .badge.format {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary);
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.625rem;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  h2 a {
    color: var(--text);
    transition: color 0.2s ease;
  }

  h2 a:hover {
    color: var(--primary);
  }

  .source {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    transition: color 0.2s ease;
  }

  .source:hover {
    color: var(--accent);
  }

  .source .material-symbols-outlined {
    font-size: 0.875rem;
  }

  .excerpt {
    color: var(--text-secondary);
    font-size: 0.925rem;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.6;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--primary);
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .read-more:hover {
    gap: 0.625rem;
    color: var(--primary-dark);
  }

  .read-more .material-symbols-outlined {
    font-size: 1rem;
    transition: transform 0.2s ease;
  }

  .read-more:hover .material-symbols-outlined {
    transform: translateX(2px);
  }
</style>