---
interface Props {
  title: string;
  url: string;
  channelName?: string;
  date: Date;
  excerpt?: string;
}

const { title, url, channelName, date, excerpt } = Astro.props;
---

<button class="share-btn" id="shareBtn">
  <span class="material-symbols-outlined">share</span>
  <span>分享文章</span>
</button>

<!-- 分享弹窗 -->
<div class="share-overlay" id="shareModal">
  <div class="share-dialog">
    <button class="share-close" id="closeShareModal">
      <span class="material-symbols-outlined">close</span>
    </button>
    
    <div class="share-card-preview">
      <canvas id="shareCanvas" width="800" height="400"></canvas>
    </div>
    
    <div class="share-actions">
      <button class="share-action-btn" id="downloadBtn">
        <span class="material-symbols-outlined">download</span>
        保存图片
      </button>
    </div>
  </div>
</div>

<script define:vars={{ title, url, channelName, date: date.toISOString(), excerpt }}>
  const ICONS = {
    group: `<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path fill="currentColor" d="M0-240v-63q0-43 44-70t116-27q13 0 26.5 1.5t26.5 4.5q-12 21-18 43t-6 45v65H0Zm240 0v-65q0-32 17.5-58.5T307-410q32-24 76.5-38t96.5-14q53 0 97.5 14t76.5 38q32 24 49 50.5t17 58.5v65H240Zm540 0v-65q0-24-6-46t-18-43q13-3 26-4.5t26-1.5q72 0 116 27t44 70v63H780ZM160-440q-33 0-56.5-23.5T80-520q0-33 23.5-56.5T160-600q33 0 56.5 23.5T240-520q0 33-23.5 56.5T160-440Zm640 0q-33 0-56.5-23.5T720-520q0-33 23.5-56.5T800-600q33 0 56.5 23.5T880-520q0 33-23.5 56.5T800-440Zm-320-40q-50 0-85-35t-35-85q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35Z"/></svg>`,
    calendar: `<svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 -960 960 960" width="20"><path fill="currentColor" d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Z"/></svg>`,
  };

  function svgToImage(svgString) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      const blob = new Blob([svgString], { type: 'image/svg+xml' });
      const url = URL.createObjectURL(blob);
      img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
      img.onerror = reject;
      img.src = url;
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const shareBtn = document.getElementById('shareBtn');
    const shareModal = document.getElementById('shareModal');
    const closeShareModal = document.getElementById('closeShareModal');
    const downloadBtn = document.getElementById('downloadBtn');
    const canvas = document.getElementById('shareCanvas');
    const ctx = canvas.getContext('2d');

    shareBtn.addEventListener('click', async () => {
      shareModal.classList.add('active');
      document.body.style.overflow = 'hidden';
      await generateShareCard();
    });

    function closeModal() {
      shareModal.classList.remove('active');
      document.body.style.overflow = '';
    }

    closeShareModal.addEventListener('click', closeModal);
    shareModal.addEventListener('click', (e) => {
      if (e.target === shareModal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && shareModal.classList.contains('active')) closeModal();
    });

    downloadBtn.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = `share-${Date.now()}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    });

    function drawRoundRect(x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx.lineTo(x + w, y + h - r);
      ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx.lineTo(x + r, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx.lineTo(x, y + r);
      ctx.quadraticCurveTo(x, y, x + r, y);
      ctx.closePath();
    }

    function wrapText(text, maxW, font) {
      ctx.font = font;
      const lines = [];
      let line = '';
      for (let i = 0; i < text.length; i++) {
        const test = line + text[i];
        if (ctx.measureText(test).width > maxW && line) {
          lines.push(line);
          line = text[i];
        } else {
          line = test;
        }
      }
      if (line) lines.push(line);
      return lines;
    }

    async function drawIcon(svg, x, y, size, color = '#64748b') {
      try {
        const img = await svgToImage(svg.replace('currentColor', color));
        ctx.drawImage(img, x, y, size, size);
      } catch (e) {}
    }

    async function generateShareCard() {
      const W = 800, H = 400;
      ctx.clearRect(0, 0, W, H);

      // 白色背景 + 圆角
      ctx.fillStyle = '#ffffff';
      drawRoundRect(0, 0, W, H, 20);
      ctx.fill();

      // 二维码区域（左侧）
      const qrSize = 180;
      const qrX = 50;
      const qrY = (H - qrSize) / 2 - 20;

      // 二维码白色背景
      ctx.fillStyle = '#f8fafc';
      drawRoundRect(qrX - 15, qrY - 15, qrSize + 30, qrSize + 30, 16);
      ctx.fill();
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      drawRoundRect(qrX - 15, qrY - 15, qrSize + 30, qrSize + 30, 16);
      ctx.stroke();

      // 二维码
      try {
        const qrUrl = `https://uapis.cn/api/v1/image/qrcode?text=${encodeURIComponent(url)}&size=${qrSize}`;
        const qrImg = await loadImage(qrUrl);
        ctx.drawImage(qrImg, qrX, qrY, qrSize, qrSize);
      } catch (e) {
        ctx.fillStyle = '#e2e8f0';
        ctx.fillRect(qrX, qrY, qrSize, qrSize);
      }

      // 扫码文字
      ctx.fillStyle = '#94a3b8';
      ctx.font = '500 14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('扫码阅读原文', qrX + qrSize / 2, qrY + qrSize + 30);

      // 右侧内容区域
      const rx = 300;
      const rw = 460;

      // 网站标识
      ctx.fillStyle = '#2563eb';
      ctx.font = '700 12px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('TURNINGCAT LOG', rx, 50);

      // 分隔线
      ctx.strokeStyle = '#f1f5f9';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(rx, 65);
      ctx.lineTo(rx + rw, 65);
      ctx.stroke();

      // 标题（大字）
      ctx.fillStyle = '#0f172a';
      ctx.font = '700 28px sans-serif';
      const titleLines = wrapText(title, rw, '700 28px sans-serif');
      let ty = 105;
      titleLines.slice(0, 3).forEach(line => {
        ctx.fillText(line, rx, ty);
        ty += 38;
      });

      // 频道名称
      if (channelName) {
        await drawIcon(ICONS.group, rx, ty + 6, 20, '#94a3b8');
        ctx.fillStyle = '#475569';
        ctx.font = '500 16px sans-serif';
        ctx.fillText(channelName, rx + 26, ty + 22);
        ty += 40;
      }

      // 日期
      const dateStr = new Date(date).toLocaleDateString('zh-CN', { 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
      });
      await drawIcon(ICONS.calendar, rx, ty + 6, 18, '#cbd5e1');
      ctx.fillStyle = '#94a3b8';
      ctx.font = '400 15px sans-serif';
      ctx.fillText(dateStr, rx + 24, ty + 21);
      ty += 40;

      // 摘要
      if (excerpt) {
        ctx.fillStyle = '#64748b';
        ctx.font = '400 15px sans-serif';
        const exText = excerpt.length > 80 ? excerpt.substring(0, 80) + '...' : excerpt;
        const exLines = wrapText(exText, rw, '400 15px sans-serif');
        exLines.slice(0, 2).forEach(line => {
          ctx.fillText(line, rx, ty);
          ty += 22;
        });
      }

      // 底部网址
      ctx.fillStyle = '#cbd5e1';
      ctx.font = '400 13px sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText('log.youzix.top', rx + rw, H - 24);

      // 整体边框
      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      drawRoundRect(0, 0, W, H, 20);
      ctx.stroke();
    }

    function loadImage(src) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = src;
      });
    }
  });
</script>

<style>
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    color: #475569;
    font-weight: 500;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .share-btn:hover {
    color: #2563eb;
    border-color: #93c5fd;
    background: #eff6ff;
  }

  .share-btn .material-symbols-outlined {
    font-size: 1.125rem;
  }

  .share-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 1rem;
  }

  .share-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .share-dialog {
    background: #ffffff;
    border-radius: 20px;
    padding: 24px;
    max-width: 540px;
    width: 100%;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    transform: translateY(20px) scale(0.98);
    transition: transform 0.3s ease;
  }

  .share-overlay.active .share-dialog {
    transform: translateY(0) scale(1);
  }

  .share-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 1;
  }

  .share-close:hover {
    background: #fee2e2;
    border-color: #fca5a5;
  }

  .share-close .material-symbols-outlined {
    font-size: 18px;
    color: #64748b;
  }

  .share-close:hover .material-symbols-outlined {
    color: #dc2626;
  }

  .share-card-preview {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #f1f5f9;
    margin-bottom: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  .share-card-preview canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  .share-actions {
    display: flex;
    justify-content: center;
  }

  .share-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    background: #2563eb;
    border: none;
    border-radius: 10px;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
  }

  .share-action-btn:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.4);
  }

  .share-action-btn .material-symbols-outlined {
    font-size: 1.25rem;
  }

  @media (max-width: 480px) {
    .share-dialog {
      padding: 16px;
      border-radius: 16px;
    }
  }
</style>