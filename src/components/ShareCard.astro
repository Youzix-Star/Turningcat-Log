---
interface Props {
  title: string;
  url: string;
  channelName?: string;
  date: Date;
  excerpt?: string;
}

const { title, url, channelName, date, excerpt } = Astro.props;
---

<div class="share-container">
  <button class="share-btn" id="shareBtn">
    <span class="material-symbols-outlined">share</span>
    <span>分享</span>
  </button>
</div>

<!-- 分享卡片弹窗 -->
<div class="dialog-overlay" id="shareModal">
  <div class="dialog-card">
    <div class="dialog-header">
      <span class="dialog-icon material-symbols-outlined">qr_code_2</span>
      <button class="dialog-close" id="closeShareModal">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>
    <div class="dialog-title">分享文章</div>
    <div class="dialog-message">保存下方图片，分享给好友</div>
    <div class="share-preview">
      <canvas id="shareCanvas" width="800" height="400"></canvas>
    </div>
    <div class="dialog-actions">
      <button class="dialog-btn" id="closeShareBtn">
        <span class="material-symbols-outlined">close</span>
        <span>关闭</span>
      </button>
      <button class="dialog-btn primary" id="downloadBtn">
        <span class="material-symbols-outlined">download</span>
        <span>保存图片</span>
      </button>
    </div>
  </div>
</div>

<script define:vars={{ title, url, channelName, date: date.toISOString(), excerpt }}>
  // Material Icons 图标 SVG
  const ICONS = {
    group: `<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path fill="currentColor" d="M0-240v-63q0-43 44-70t116-27q13 0 26.5 1.5t26.5 4.5q-12 21-18 43t-6 45v65H0Zm240 0v-65q0-32 17.5-58.5T307-410q32-24 76.5-38t96.5-14q53 0 97.5 14t76.5 38q32 24 49 50.5t17 58.5v65H240Zm540 0v-65q0-24-6-46t-18-43q13-3 26-4.5t26-1.5q72 0 116 27t44 70v63H780ZM160-440q-33 0-56.5-23.5T80-520q0-33 23.5-56.5T160-600q33 0 56.5 23.5T240-520q0 33-23.5 56.5T160-440Zm640 0q-33 0-56.5-23.5T720-520q0-33 23.5-56.5T800-600q33 0 56.5 23.5T880-520q0 33-23.5 56.5T800-440Zm-320-40q-50 0-85-35t-35-85q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35Z"/></svg>`,
    calendar: `<svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 -960 960 960" width="20"><path fill="currentColor" d="M200-80q-33 0-56.5-23.5T120-160v-560q0-33 23.5-56.5T200-800h40v-80h80v80h320v-80h80v80h40q33 0 56.5 23.5T840-720v560q0 33-23.5 56.5T760-80H200Zm0-80h560v-400H200v400Zm0-480h560v-80H200v80Zm0 0v-80 80Z"/></svg>`,
  };

  function svgToImage(svgString) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      const blob = new Blob([svgString], { type: 'image/svg+xml' });
      const url = URL.createObjectURL(blob);
      img.onload = () => {
        URL.revokeObjectURL(url);
        resolve(img);
      };
      img.onerror = reject;
      img.src = url;
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const shareBtn = document.getElementById('shareBtn');
    const shareModal = document.getElementById('shareModal');
    const closeShareModal = document.getElementById('closeShareModal');
    const closeShareBtn = document.getElementById('closeShareBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const canvas = document.getElementById('shareCanvas');
    const ctx = canvas.getContext('2d');

    shareBtn.addEventListener('click', async () => {
      shareModal.classList.add('open');
      document.body.style.overflow = 'hidden';
      await generateShareCard();
    });

    function closeModal() {
      shareModal.classList.remove('open');
      document.body.style.overflow = '';
    }

    closeShareModal.addEventListener('click', closeModal);
    closeShareBtn.addEventListener('click', closeModal);
    shareModal.addEventListener('click', (e) => {
      if (e.target === shareModal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && shareModal.classList.contains('open')) {
        closeModal();
      }
    });

    downloadBtn.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = `share-${Date.now()}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    });

    function drawRoundRect(x, y, width, height, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + width - radius, y);
      ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
      ctx.lineTo(x + width, y + height - radius);
      ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
      ctx.lineTo(x + radius, y + height);
      ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
    }

    function wrapText(text, maxWidth, font) {
      ctx.font = font;
      const lines = [];
      let currentLine = '';
      for (let i = 0; i < text.length; i++) {
        const testLine = currentLine + text[i];
        const metrics = ctx.measureText(testLine);
        if (metrics.width > maxWidth && currentLine !== '') {
          lines.push(currentLine);
          currentLine = text[i];
        } else {
          currentLine = testLine;
        }
      }
      if (currentLine) lines.push(currentLine);
      return lines;
    }

    async function drawIcon(iconSvg, x, y, size, color = '#64748b') {
      try {
        const img = await svgToImage(iconSvg.replace('currentColor', color));
        ctx.drawImage(img, x, y, size, size);
      } catch (e) {
        console.error('Failed to draw icon:', e);
      }
    }

    async function generateShareCard() {
      const width = 800;
      const height = 400;

      ctx.clearRect(0, 0, width, height);

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);

      const gradient = ctx.createLinearGradient(0, 0, 300, height);
      gradient.addColorStop(0, '#2563eb');
      gradient.addColorStop(1, '#0ea5e9');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, 300, height);

      try {
        const qrUrl = `https://uapis.cn/api/v1/image/qrcode?text=${encodeURIComponent(url)}&size=200`;
        const qrImage = await loadImage(qrUrl);
        ctx.fillStyle = '#ffffff';
        drawRoundRect(50, 100, 200, 200, 16);
        ctx.fill();
        ctx.drawImage(qrImage, 60, 110, 180, 180);
      } catch (e) {
        ctx.fillStyle = '#ffffff';
        drawRoundRect(50, 100, 200, 200, 16);
        ctx.fill();
        ctx.fillStyle = '#94a3b8';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('二维码加载失败', 150, 200);
      }

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('扫码阅读原文', 150, 340);

      const rightX = 340;
      const rightWidth = 420;

      ctx.fillStyle = '#2563eb';
      ctx.font = 'bold 12px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('TURNINGCAT LOG', rightX, 40);

      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(rightX, 50);
      ctx.lineTo(rightX + rightWidth, 50);
      ctx.stroke();

      ctx.fillStyle = '#0f172a';
      const titleFont = 'bold 22px sans-serif';
      const titleLines = wrapText(title, rightWidth, titleFont);
      ctx.font = titleFont;
      let titleY = 85;
      titleLines.forEach(line => {
        ctx.fillText(line, rightX, titleY);
        titleY += 30;
      });

      if (channelName) {
        await drawIcon(ICONS.group, rightX, titleY + 2, 18, '#64748b');
        ctx.fillStyle = '#64748b';
        ctx.font = '14px sans-serif';
        ctx.fillText(channelName, rightX + 24, titleY + 16);
        titleY += 35;
      }

      const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      
      await drawIcon(ICONS.calendar, rightX, titleY + 2, 16, '#94a3b8');
      ctx.fillStyle = '#94a3b8';
      ctx.font = '13px sans-serif';
      ctx.fillText(formattedDate, rightX + 22, titleY + 15);

      if (excerpt) {
        ctx.fillStyle = '#64748b';
        const excerptFont = '13px sans-serif';
        const excerptText = excerpt.length > 80 ? excerpt.substring(0, 80) + '...' : excerpt;
        const excerptLines = wrapText(excerptText, rightWidth, excerptFont);
        ctx.font = excerptFont;
        let excerptY = titleY + 45;
        excerptLines.slice(0, 2).forEach(line => {
          ctx.fillText(line, rightX, excerptY);
          excerptY += 20;
        });
      }

      ctx.fillStyle = '#94a3b8';
      ctx.font = '12px sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText('log.youzix.top', rightX + rightWidth, height - 20);

      ctx.strokeStyle = '#e2e8f0';
      ctx.lineWidth = 1;
      ctx.strokeRect(300, 0, width - 300, height);
    }

    function loadImage(src) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = src;
      });
    }
  });
</script>

<style>
  .share-container {
    display: inline-block;
  }

  /* 分享按钮 - 与其他按钮风格统一 */
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .share-btn:hover {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .share-btn .material-symbols-outlined {
    font-size: 1.125rem;
  }

  /* 弹窗样式 */
  .dialog-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .dialog-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .dialog-card {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 28px;
    max-width: 500px;
    width: 90%;
    text-align: center;
    box-shadow: 
      0 32px 64px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(255, 255, 255, 0.6);
    transform: translateY(20px);
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .dialog-overlay.open .dialog-card {
    transform: translateY(0);
  }

  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .dialog-icon {
    font-size: 36px;
    color: var(--primary);
  }

  .dialog-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dialog-close:hover {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
  }

  .dialog-close .material-symbols-outlined {
    font-size: 18px;
    color: inherit;
  }

  .dialog-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text);
  }

  .dialog-message {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .share-preview {
    margin-bottom: 20px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
  }

  .share-preview canvas {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .dialog-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
  }

  /* 弹窗按钮 - 统一风格 */
  .dialog-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .dialog-btn:hover {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .dialog-btn .material-symbols-outlined {
    font-size: 1rem;
  }

  .dialog-btn.primary {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
  }

  .dialog-btn.primary:hover {
    background: var(--primary-dark);
    border-color: var(--primary-dark);
    color: white;
  }

  @media (max-width: 480px) {
    .dialog-card {
      padding: 20px;
    }

    .dialog-actions {
      flex-direction: column;
    }

    .dialog-btn {
      justify-content: center;
    }
  }
</style>