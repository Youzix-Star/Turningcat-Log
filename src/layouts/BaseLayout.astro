---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Turningcat 日志', description = 'Telegram 频道消息日志归档' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --primary: #3b82f6;
        --primary-dark: #2563eb;
        --bg: #0f172a;
        --bg-card: #1e293b;
        --text: #e2e8f0;
        --text-secondary: #94a3b8;
        --border: #334155;
        --accent: #22d3ee;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans SC', sans-serif;
        background-color: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
      }

      a {
        color: var(--primary);
        text-decoration: none;
        transition: color 0.2s;
      }

      a:hover {
        color: var(--primary-dark);
      }

      code {
        background: var(--bg-card);
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
      }

      pre {
        background: var(--bg-card);
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        margin: 1rem 0;
      }

      pre code {
        background: none;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>