---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogCard from '../components/LogCard.astro';
import { getCollection } from 'astro:content';

// 获取所有日志并按时间倒序排列
const logs = (await getCollection('logs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 统计信息
const totalCount = logs.length;
const translatedCount = logs.filter(log => log.data.translated).length;
---

<BaseLayout title="Turningcat Log - 频道日志归档">
  <Header />

  <main>
    <section class="hero">
      <h1>📋 Turningcat Log</h1>
      <p>Telegram 频道消息自动归档与翻译</p>
      <div class="stats">
        <div class="stat">
          <span class="stat-number">{totalCount}</span>
          <span class="stat-label">篇日志</span>
        </div>
        <div class="stat">
          <span class="stat-number">{translatedCount}</span>
          <span class="stat-label">篇已翻译</span>
        </div>
      </div>
    </section>

    <section class="logs-grid">
      {logs.length === 0 ? (
        <div class="empty">
          <p>📭 暂无日志</p>
          <p>使用 <a href="https://t.me/your_bot">Telegram Bot</a> 转发频道消息即可生成</p>
        </div>
      ) : (
        logs.map(log => (
          <LogCard
            title={log.data.title}
            date={log.data.date}
            source={log.data.source}
            slug={log.slug}
            translated={log.data.translated}
            format={log.data.format}
            excerpt={log.body?.substring(0, 150)}
          />
        ))
      )}
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }

  .hero {
    text-align: center;
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--accent), var(--primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-top: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .logs-grid {
    display: grid;
    gap: 1.5rem;
  }

  .empty {
    text-align: center;
    padding: 4rem;
    color: var(--text-secondary);
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px dashed var(--border);
  }

  .empty p:first-child {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: 1.75rem;
    }

    .stats {
      gap: 2rem;
    }

    main {
      padding: 1rem;
    }
  }
</style>