---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogCard from '../components/LogCard.astro';
import { getCollection } from 'astro:content';

const logs = (await getCollection('logs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const totalCount = logs.length;
const translatedCount = logs.filter(log => log.data.translated).length;

// 收集所有标签并统计数量
const tagMap = new Map<string, number>();
logs.forEach(log => {
  if (log.data.tags) {
    log.data.tags.forEach(tag => {
      tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
    });
  }
});
const allTags = Array.from(tagMap.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Turningcat Log - 频道日志归档">
  <Header />

  <main>
    <section class="hero">
      <div class="hero-content">
        <div class="hero-icon">
          <span class="material-symbols-outlined icon-filled">auto_stories</span>
        </div>
        <h1>Turningcat Log</h1>
        <p class="hitokoto-text" id="hitokoto">正在加载一言...</p>
        <p class="hitokoto-from" id="hitokoto-from"></p>
        <div class="stats">
          <div class="stat">
            <span class="material-symbols-outlined">description</span>
            <span class="stat-number">{totalCount}</span>
            <span class="stat-label">篇日志</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="material-symbols-outlined">translate</span>
            <span class="stat-number">{translatedCount}</span>
            <span class="stat-label">篇已翻译</span>
          </div>
        </div>
      </div>
    </section>

    {allTags.length > 0 && (
      <section class="tags-filter">
        <div class="tags-scroll">
          <button class="filter-tag active" data-filter="all">
            <span class="material-symbols-outlined">apps</span>
            全部
          </button>
          {allTags.map(([tag, count]) => (
            <button class="filter-tag" data-filter={tag}>
              <span class="material-symbols-outlined">label</span>
              {tag}
              <span class="count">{count}</span>
            </button>
          ))}
        </div>
      </section>
    )}

    <section class="logs-grid">
      {logs.length === 0 ? (
        <div class="empty">
          <span class="material-symbols-outlined">inbox</span>
          <p>暂无日志</p>
          <p class="empty-hint">使用 Telegram Bot 转发频道消息即可生成</p>
        </div>
      ) : (
        logs.map(log => (
          <LogCard
            title={log.data.title}
            date={log.data.date}
            source={log.data.source}
            slug={log.slug}
            translated={log.data.translated}
            format={log.data.format}
            excerpt={log.body?.substring(0, 150)}
            channelName={log.data.channelName}
            channelUsername={log.data.channelUsername}
            channelAvatar={log.data.channelAvatar}
            tags={log.data.tags}
          />
        ))
      )}
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // 获取一言
  async function fetchHitokoto() {
    try {
      const response = await fetch('https://v1.hitokoto.cn/');
      const data = await response.json();
      
      const hitokotoEl = document.getElementById('hitokoto');
      const fromEl = document.getElementById('hitokoto-from');
      
      if (hitokotoEl && data.hitokoto) {
        hitokotoEl.textContent = `「${data.hitokoto}」`;
      }
      
      if (fromEl && data.from) {
        fromEl.textContent = `—— ${data.from}`;
      }
    } catch (error) {
      const hitokotoEl = document.getElementById('hitokoto');
      if (hitokotoEl) {
        hitokotoEl.textContent = '转发频道消息给我，即可导出为 TXT 或 MD 文件';
      }
    }
  }

  // 标签筛选功能
  function initTagFilter() {
    const filterButtons = document.querySelectorAll('.filter-tag');
    const logCards = document.querySelectorAll('.log-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        
        filterButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        
        logCards.forEach(card => {
          const cardTags = card.getAttribute('data-tags')?.split(',').filter(Boolean) || [];
          
          if (filter === 'all' || cardTags.includes(filter)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    document.querySelectorAll('.tag[data-tag]').forEach(tag => {
      tag.addEventListener('click', (e) => {
        e.preventDefault();
        const tagName = tag.getAttribute('data-tag');
        const filterBtn = document.querySelector(`.filter-tag[data-filter="${tagName}"]`);
        if (filterBtn) {
          (filterBtn as HTMLElement).click();
          document.querySelector('.tags-filter')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  // 初始化
  document.addEventListener('DOMContentLoaded', () => {
    fetchHitokoto();
    initTagFilter();
  });
</script>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }

  .hero {
    text-align: center;
    padding: 4rem 2rem;
    margin-bottom: 2rem;
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 24px;
    box-shadow: var(--shadow);
  }

  .hero-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .hero-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 16px rgba(37, 99, 235, 0.25);
  }

  .hero-icon .material-symbols-outlined {
    font-size: 2.5rem;
    color: white;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--text), var(--primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hitokoto-text {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 0.5rem;
    min-height: 1.5rem;
    font-style: italic;
    line-height: 1.6;
  }

  .hitokoto-from {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 2rem;
    min-height: 1.25rem;
  }

  .stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat .material-symbols-outlined {
    font-size: 1.5rem;
    color: var(--primary);
    margin-bottom: 0.25rem;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background: var(--border);
  }

  /* 标签筛选栏 */
  .tags-filter {
    margin-bottom: 2rem;
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 16px;
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .tags-scroll {
    display: flex;
    gap: 0.625rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--text-muted) transparent;
  }

  .tags-scroll::-webkit-scrollbar {
    height: 4px;
  }

  .tags-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .tags-scroll::-webkit-scrollbar-thumb {
    background: var(--text-muted);
    border-radius: 2px;
  }

  .filter-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .filter-tag:hover {
    color: var(--primary);
    border-color: rgba(37, 99, 235, 0.3);
    background: rgba(37, 99, 235, 0.05);
  }

  .filter-tag.active {
    color: white;
    background: var(--primary);
    border-color: var(--primary);
  }

  .filter-tag .material-symbols-outlined {
    font-size: 1rem;
  }

  .filter-tag .count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 0.375rem;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    font-size: 0.7rem;
  }

  .filter-tag.active .count {
    background: rgba(255, 255, 255, 0.25);
  }

  .logs-grid {
    display: grid;
    gap: 1.25rem;
  }

  .empty {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }

  .empty .material-symbols-outlined {
    font-size: 3rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .empty p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .empty-hint {
    color: var(--text-muted) !important;
    font-size: 0.9rem !important;
    font-weight: 400 !important;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    main {
      padding: 1rem;
    }

    .hero {
      padding: 2.5rem 1.5rem;
    }

    .hero h1 {
      font-size: 1.75rem;
    }

    .hitokoto-text {
      font-size: 0.9rem;
    }

    .stats {
      gap: 1.5rem;
    }

    .stat-number {
      font-size: 1.5rem;
    }

    .tags-filter {
      padding: 0.75rem 1rem;
    }

    .filter-tag {
      padding: 0.4rem 0.75rem;
      font-size: 0.8rem;
    }
  }
</style>