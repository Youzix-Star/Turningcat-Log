---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogCard from '../components/LogCard.astro';
import { getCollection } from 'astro:content';

const logs = (await getCollection('logs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const totalCount = logs.length;
const translatedCount = logs.filter(log => log.data.translated).length;
---

<BaseLayout title="Turningcat Log - 频道日志归档">
  <Header />

  <main>
    <section class="hero">
      <div class="hero-content">
        <div class="hero-icon">
          <span class="material-symbols-outlined icon-filled">auto_stories</span>
        </div>
        <h1>Turningcat Log</h1>
        <p>Telegram 频道消息自动归档与翻译</p>
        <div class="stats">
          <div class="stat">
            <span class="material-symbols-outlined">description</span>
            <span class="stat-number">{totalCount}</span>
            <span class="stat-label">篇日志</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="material-symbols-outlined">translate</span>
            <span class="stat-number">{translatedCount}</span>
            <span class="stat-label">篇已翻译</span>
          </div>
        </div>
      </div>
    </section>

    <section class="logs-grid">
      {logs.length === 0 ? (
        <div class="empty">
          <span class="material-symbols-outlined">inbox</span>
          <p>暂无日志</p>
          <p class="empty-hint">使用 Telegram Bot 转发频道消息即可生成</p>
        </div>
      ) : (
        logs.map(log => (
          <LogCard
            title={log.data.title}
            date={log.data.date}
            source={log.data.source}
            slug={log.slug}
            translated={log.data.translated}
            format={log.data.format}
            excerpt={log.body?.substring(0, 150)}
          />
        ))
      )}
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }

  .hero {
    text-align: center;
    padding: 4rem 2rem;
    margin-bottom: 3rem;
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 24px;
    box-shadow: var(--shadow);
  }

  .hero-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .hero-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 16px rgba(37, 99, 235, 0.25);
  }

  .hero-icon .material-symbols-outlined {
    font-size: 2.5rem;
    color: white;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--text), var(--primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat .material-symbols-outlined {
    font-size: 1.5rem;
    color: var(--primary);
    margin-bottom: 0.25rem;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background: var(--border);
  }

  .logs-grid {
    display: grid;
    gap: 1.25rem;
  }

  .empty {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }

  .empty .material-symbols-outlined {
    font-size: 3rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .empty p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .empty-hint {
    color: var(--text-muted) !important;
    font-size: 0.9rem !important;
    font-weight: 400 !important;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    main {
      padding: 1rem;
    }

    .hero {
      padding: 2.5rem 1.5rem;
    }

    .hero h1 {
      font-size: 1.75rem;
    }

    .stats {
      gap: 1.5rem;
    }

    .stat-number {
      font-size: 1.5rem;
    }
  }
</style>