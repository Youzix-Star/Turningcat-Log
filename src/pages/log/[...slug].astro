---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  return logs.map(log => ({
    params: { slug: log.slug },
    props: { log },
  }));
}

const { log } = Astro.props;
const { Content } = await log.render();

const formatDate = (d: Date) => {
  return d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    weekday: 'long',
  });
};

const getSourceName = (url?: string) => {
  if (!url) return '未知来源';
  const match = url.match(/t\.me\/([^/]+)/);
  return match ? `@${match[1]}` : '频道';
};
---

<BaseLayout title={`${log.data.title} - Turningcat Log`}>
  <Header />

  <main>
    <article class="log-article">
      <div class="article-header">
        <a href="/" class="back-link">
          <span class="material-symbols-outlined">arrow_back</span>
          <span>返回列表</span>
        </a>

        <h1>{log.data.title}</h1>

        <div class="meta">
          <div class="meta-item">
            <span class="material-symbols-outlined">calendar_today</span>
            <time datetime={log.data.date.toISOString()}>
              {formatDate(log.data.date)}
            </time>
          </div>

          {log.data.source && (
            <a href={log.data.source} target="_blank" rel="noopener noreferrer" class="meta-item source-link">
              <span class="material-symbols-outlined">link</span>
              <span>{getSourceName(log.data.source)}</span>
            </a>
          )}

          <div class="badges">
            {log.data.translated && (
              <span class="badge translated">
                <span class="material-symbols-outlined">translate</span>
                已翻译
              </span>
            )}
            {log.data.format && (
              <span class="badge format">
                <span class="material-symbols-outlined">description</span>
                {log.data.format.toUpperCase()}
              </span>
            )}
          </div>
        </div>
      </div>

      <div class="article-content">
        <Content />
      </div>

      <div class="article-footer">
        <a href="/" class="back-link">
          <span class="material-symbols-outlined">arrow_back</span>
          <span>返回列表</span>
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }

  .log-article {
    background: var(--bg-card);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .article-header {
    padding: 2rem;
    border-bottom: var(--glass-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    color: var(--primary);
    background: rgba(37, 99, 235, 0.08);
  }

  .back-link .material-symbols-outlined {
    font-size: 1.125rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .meta-item .material-symbols-outlined {
    font-size: 1rem;
  }

  .source-link {
    transition: color 0.2s ease;
  }

  .source-link:hover {
    color: var(--accent);
  }

  .badges {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge .material-symbols-outlined {
    font-size: 0.875rem;
  }

  .badge.translated {
    background: rgba(14, 165, 233, 0.1);
    color: var(--accent);
  }

  .badge.format {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary);
  }

  .article-content {
    padding: 2rem;
    line-height: 1.8;
  }

  .article-content :global(h2) {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: var(--glass-border);
    letter-spacing: -0.01em;
  }

  .article-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
  }

  .article-content :global(p) {
    margin-bottom: 1rem;
    color: var(--text);
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    background: rgba(37, 99, 235, 0.05);
    border-radius: 0 8px 8px 0;
    color: var(--text-secondary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: rgba(37, 99, 235, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s ease;
  }

  .article-content :global(a:hover) {
    text-decoration-color: var(--primary);
  }

  .article-footer {
    padding: 1.5rem 2rem;
    border-top: var(--glass-border);
  }

  @media (max-width: 640px) {
    main {
      padding: 1rem;
    }

    .article-header,
    .article-content,
    .article-footer {
      padding: 1.5rem;
    }

    h1 {
      font-size: 1.375rem;
    }

    .meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .badges {
      margin-left: 0;
    }
  }
</style>